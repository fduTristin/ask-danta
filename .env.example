# Copy to .env in the repository root. Never commit real keys.
# DeepSeek Chat Completions. Thinking and request budgets are configurable.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
MODEL_THINKING=disabled
MODEL_REASONING_EFFORT=low
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=45

# mock: clearly labelled fixed fixtures, no network. tavily: actual search.
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_DEPTH=basic
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5
SEARCH_MAX_SNIPPET_CHARS=2000

# Project-owned credentials; missing file does not prevent startup.
CAMPUS_AUTH_FILE=.private/campus-tokens.json

# HTTP and Agent budgets are enforced. Campus pages are reserved for step 3.
HTTP_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS=6
MAX_CAMPUS_PAGES=3
REQUEST_BUDGET_SECONDS=90

# Loopback-only development servers.
BACKEND_PORT=8000
FRONTEND_PORT=5173
