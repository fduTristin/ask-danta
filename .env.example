# Copy to .env in the repository root. Never commit real keys.
# DeepSeek, OpenAI-compatible. Step 1 configures this; chat starts in step 2.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=

# mock: clearly labelled fixed fixtures, no network. tavily: actual search.
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_MAX_SNIPPET_CHARS=2000

# Project-owned credentials; missing file does not prevent startup.
CAMPUS_AUTH_FILE=.private/campus-tokens.json

# HTTP timeout is active now. Agent budgets are reserved for step 2/3.
HTTP_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS=6
MAX_CAMPUS_PAGES=3
REQUEST_BUDGET_SECONDS=90

# Loopback-only development servers.
BACKEND_PORT=8000
FRONTEND_PORT=5173
